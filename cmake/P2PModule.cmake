# p2p_module(NAME <dom>/<mod> SOURCES <f>... DEPS <dep>...)
#   - lib statique p2p_<dom>_<mod> depuis src/<dom>/<mod>/*.c (SOURCES omis) ou la liste SOURCES
#   - include dir PUBLIC = src/ ; deps "<dom>/<mod>" -> p2p_<dom>_<mod>, autres cibles passées telles quelles
#   - tests/<dom>/<mod>/test_*.c -> un exécutable chacun, enregistré CTest, label <dom>/<mod>
#   - P2P_VALGRIND=ON : chaque test est lancé sous valgrind memcheck (échec si erreur ou fuite)
function(p2p_module)
    cmake_parse_arguments(P2P "" "NAME" "SOURCES;DEPS" ${ARGN})
    if(NOT P2P_NAME)
        message(FATAL_ERROR "p2p_module: NAME requis")
    endif()

    string(REPLACE "/" "_" _slug "${P2P_NAME}")
    set(_lib "p2p_${_slug}")
    set(_src_dir "${P2P_SRC_ROOT}/${P2P_NAME}")
    set(_test_dir "${P2P_TEST_ROOT}/${P2P_NAME}")

    if(NOT P2P_SOURCES)
        file(GLOB P2P_SOURCES CONFIGURE_DEPENDS "${_src_dir}/*.c")
    else()
        list(TRANSFORM P2P_SOURCES PREPEND "${_src_dir}/")
    endif()

    set(_link_deps "")
    set(_needs_noise FALSE)
    foreach(_dep IN LISTS P2P_DEPS)
        if(_dep MATCHES "/")
            string(REPLACE "/" "_" _dep_slug "${_dep}")
            list(APPEND _link_deps "p2p_${_dep_slug}")
        else()
            list(APPEND _link_deps "${_dep}")
            if(_dep STREQUAL "noise::protocol")
                set(_needs_noise TRUE)
            endif()
        endif()
    endforeach()

    if(NOT P2P_SOURCES)
        message(STATUS "p2p: ${_lib} sans source (en cours d'implémentation), ignoré")
        return()
    endif()
    add_library(${_lib} STATIC ${P2P_SOURCES})
    target_include_directories(${_lib} PUBLIC "${P2P_SRC_ROOT}")
    target_link_libraries(${_lib} PUBLIC ${_link_deps})
    if(_needs_noise)
        add_dependencies(${_lib} noise_c)
    endif()

    file(GLOB _tests CONFIGURE_DEPENDS "${_test_dir}/test_*.c")
    foreach(_test IN LISTS _tests)
        get_filename_component(_test_name "${_test}" NAME_WE)
        set(_exe "${_slug}_${_test_name}")
        add_executable(${_exe} "${_test}")
        target_include_directories(${_exe} PRIVATE "${P2P_TEST_ROOT}")
        target_link_libraries(${_exe} PRIVATE ${_lib})
        if(_needs_noise)
            add_dependencies(${_exe} noise_c)
        endif()

        set(_ctest_name "${P2P_NAME}/${_test_name}")
        if(P2P_VALGRIND)
            find_program(P2P_VALGRIND_EXE valgrind REQUIRED)
            add_test(NAME "${_ctest_name}" COMMAND "${P2P_VALGRIND_EXE}"
                --quiet --error-exitcode=1 --leak-check=full --errors-for-leak-kinds=all
                --suppressions=${CMAKE_SOURCE_DIR}/scripts/valgrind.supp
                $<TARGET_FILE:${_exe}>)
        else()
            add_test(NAME "${_ctest_name}" COMMAND ${_exe})
        endif()
        set_tests_properties("${_ctest_name}" PROPERTIES LABELS "${P2P_NAME}")
    endforeach()
endfunction()
